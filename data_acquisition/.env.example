# Copy to data_acquisition/.env and fill in. Never commit the real .env.

# Dhan (20-level market depth) — access token is valid for 30 days
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Zerodha Kite Connect (5-level depth) — access token must be refreshed daily before 09:15 IST
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# AWS (S3 bucket with the collected parquet files)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: extra .env files that kite_refresh_token.py should also update (colon-separated paths)
EXTRA_ENV_PATHS=
